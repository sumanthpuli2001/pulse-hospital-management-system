# ==========================================
# Hospital Management System (HMS) Environment Configuration
# Copy this file to .env before starting containers
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_management
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root

# Server & Application Ports
SERVER_PORT=8085
FRONTEND_PORT=80

# Security & JWT Tokens (Must be at least 256-bit hexadecimal or Base64 string in production)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Security Rate Limiting & Account Lockout
SECURITY_AUTH_MAX_FAILED_ATTEMPTS=5
SECURITY_AUTH_LOCKOUT_DURATION_MINUTES=15
